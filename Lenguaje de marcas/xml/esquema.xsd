<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <!-- =========================================================
         ESQUEMA DE VALIDACIÓN - INVENTARIO MOGARRY
         Autor: Proyecto Intermodular 1º ASIR
         Módulo: 0373 - Lenguajes de Marcas
    ========================================================= -->


    <!-- ===== TIPOS SIMPLES (con restricciones) ================ -->

    <!-- CIF español: letra + 8 dígitos -->
    <xs:simpleType name="tipoCIF">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z][0-9]{8}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- IPv4 con 4 octetos -->
    <xs:simpleType name="tipoIPv4">
        <xs:restriction base="xs:string">
            <xs:pattern value="((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- MAC: 6 grupos hex separados por ':' -->
    <xs:simpleType name="tipoMAC">
        <xs:restriction base="xs:string">
            <xs:pattern value="([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Número de serie con formato FABRICANTE-MODELO-AÑO-NUM -->
    <xs:simpleType name="tipoNumeroSerie">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2,4}-[A-Z0-9]+-[0-9]{4}-[A-Z0-9]+"/>
            <xs:minLength value="10"/>
            <xs:maxLength value="40"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- VLAN entre 1 y 4094 -->
    <xs:simpleType name="tipoVLAN">
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="4094"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Temperatura razonable de datacenter (15ºC a 30ºC) -->
    <xs:simpleType name="tipoTemperatura">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="15.0"/>
            <xs:maxInclusive value="30.0"/>
            <xs:fractionDigits value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Tipos de equipo (enumeración) -->
    <xs:simpleType name="tipoEquipo">
        <xs:restriction base="xs:string">
            <xs:enumeration value="servidor"/>
            <xs:enumeration value="switch"/>
            <xs:enumeration value="router"/>
            <xs:enumeration value="firewall"/>
            <xs:enumeration value="nas"/>
            <xs:enumeration value="sai"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Estado del equipo (enumeración) -->
    <xs:simpleType name="tipoEstado">
        <xs:restriction base="xs:string">
            <xs:enumeration value="operativo"/>
            <xs:enumeration value="mantenimiento"/>
            <xs:enumeration value="baja"/>
            <xs:enumeration value="almacen"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Certificación del datacenter -->
    <xs:simpleType name="tipoCertificacion">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Tier I"/>
            <xs:enumeration value="Tier II"/>
            <xs:enumeration value="Tier III"/>
            <xs:enumeration value="Tier IV"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Código de rack: R-XX -->
    <xs:simpleType name="tipoRack">
        <xs:restriction base="xs:string">
            <xs:pattern value="R-[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Unidad de rack: U00 a U42 -->
    <xs:simpleType name="tipoUnidad">
        <xs:restriction base="xs:string">
            <xs:pattern value="U[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Versión: X.Y.Z -->
    <xs:simpleType name="tipoVersion">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+"/>
        </xs:restriction>
    </xs:simpleType>


    <!-- ===== TIPOS COMPLEJOS =================================== -->

    <!-- Bloque <empresa> -->
    <xs:complexType name="tipoEmpresa">
        <xs:sequence>
            <xs:element name="nombre"            type="xs:string"/>
            <xs:element name="cif"               type="tipoCIF"/>
            <xs:element name="fecha-inventario"  type="xs:date"/>
            <xs:element name="responsable"       type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Bloque <sala> (con id único) -->
    <xs:complexType name="tipoSala">
        <xs:sequence>
            <xs:element name="nombre"                type="xs:string"/>
            <xs:element name="capacidad-u"           type="xs:positiveInteger"/>
            <xs:element name="temperatura-objetivo"  type="tipoTemperatura"/>
            <xs:element name="certificacion"         type="tipoCertificacion"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>

    <!-- Bloque <ubicacion> (referencia a la sala mediante IDREF) -->
    <xs:complexType name="tipoUbicacion">
        <xs:attribute name="sala"   type="xs:IDREF"   use="required"/>
        <xs:attribute name="rack"   type="tipoRack"   use="required"/>
        <xs:attribute name="unidad" type="tipoUnidad" use="required"/>
    </xs:complexType>

    <!-- Bloque <red> -->
    <xs:complexType name="tipoRed">
        <xs:sequence>
            <xs:element name="ip"   type="tipoIPv4"/>
            <xs:element name="mac"  type="tipoMAC"/>
            <xs:element name="vlan" type="tipoVLAN"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Bloque <servicios> -->
    <xs:complexType name="tipoServicios">
        <xs:sequence>
            <xs:element name="servicio" type="xs:string" minOccurs="1" maxOccurs="10"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Bloque <equipo> -->
    <xs:complexType name="tipoEquipo_full">
        <xs:sequence>
            <xs:element name="fabricante"    type="xs:string"/>
            <xs:element name="modelo"        type="xs:string"/>
            <xs:element name="numero-serie"  type="tipoNumeroSerie"/>
            <xs:element name="ubicacion"     type="tipoUbicacion"/>
            <xs:element name="red"           type="tipoRed"      minOccurs="0"/>
            <xs:element name="fecha-compra"  type="xs:date"/>
            <xs:element name="fin-garantia"  type="xs:date"/>
            <xs:element name="servicios"     type="tipoServicios"/>
        </xs:sequence>
        <xs:attribute name="id"     type="xs:ID"        use="required"/>
        <xs:attribute name="tipo"   type="tipoEquipo"   use="required"/>
        <xs:attribute name="estado" type="tipoEstado"   use="required"/>
    </xs:complexType>


    <!-- ===== ELEMENTO RAÍZ ===================================== -->

    <xs:element name="inventario">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="empresa" type="tipoEmpresa"/>

                <xs:element name="salas">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="sala" type="tipoSala"
                                        minOccurs="1" maxOccurs="10"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="equipos">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="equipo" type="tipoEquipo_full"
                                        minOccurs="1" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="version" type="tipoVersion" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>